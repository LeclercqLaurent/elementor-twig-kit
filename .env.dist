# Elementor Twig Kit configuration: TEMPLATE.
#
# Copy this file to ".env" in the plugin directory, on each server. The .env is
# not versioned: it carries secrets and has to survive a deployment that
# overwrites the directory.

# Demo mode: offers come from the bundled fictional dataset and no API is
# called. This is the default, so the plugin is usable the moment it is
# activated.
JOBS_DEMO_MODE=true

# The offers API. Both are required as soon as JOBS_DEMO_MODE is false: if one
# is missing, the widgets disable themselves, the server log explains why, and
# the page is still served.
JOBS_API_URL=
JOBS_API_TOKEN=

# Timeout of an API call, in seconds.
JOBS_API_TIMEOUT=5

# How long results are cached, in seconds (0 disables caching).
JOBS_CACHE_TTL=300

# Verbose Twig tracing. Leave this false in production.
JOBS_DEBUG=false
