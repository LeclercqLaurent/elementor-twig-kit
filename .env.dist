# Configuration d'Elementor Twig Kit — GABARIT.
#
# Copier ce fichier en « .env » dans le dossier du plugin, sur chaque serveur.
# Le .env n'est pas versionné : il porte des secrets et doit survivre à un
# déploiement qui écrase le dossier.

# Mode démonstration : les offres viennent du jeu fictif embarqué, aucune API
# n'est appelée. C'est la valeur par défaut, pour que le plugin soit utilisable
# dès son activation.
JOBS_DEMO_MODE=true

# API des offres. Obligatoires dès que JOBS_DEMO_MODE vaut false : si l'une
# manque, les widgets se désactivent et le journal du serveur l'explique — la
# page reste servie.
JOBS_API_URL=
JOBS_API_TOKEN=

# Délai d'attente d'un appel API, en secondes.
JOBS_API_TIMEOUT=5

# Durée de cache des résultats, en secondes (0 pour désactiver).
JOBS_CACHE_TTL=300

# Trace Twig détaillée. À laisser à false en production.
JOBS_DEBUG=false
