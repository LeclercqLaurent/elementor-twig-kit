{#
    The search form. Every field carries an associated label, submission happens
    over GET so a search stays shareable and replayable, and the submit control
    is a real button rather than a styled link.
#}
<form class="etk-search" method="get" action="{{ action }}" role="search">
    <p class="etk-search__field">
        <label class="etk-search__label" for="{{ id_prefix }}-q">Keyword</label>
        <input class="etk-search__input" type="search" id="{{ id_prefix }}-q" name="q"
               value="{{ query.keywords }}" autocomplete="off">
    </p>

    <p class="etk-search__field">
        <label class="etk-search__label" for="{{ id_prefix }}-city">City</label>
        <input class="etk-search__input" type="text" id="{{ id_prefix }}-city" name="city"
               value="{{ query.city }}" autocomplete="address-level2">
    </p>

    <p class="etk-search__field">
        <label class="etk-search__label" for="{{ id_prefix }}-contract">Contract</label>
        <select class="etk-search__input" id="{{ id_prefix }}-contract" name="contract">
            <option value="">All contracts</option>
            {% for value, label in contracts %}
                <option value="{{ value }}"{% if value == query.contract %} selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
    </p>

    <p class="etk-search__actions">
        <button class="etk-search__submit" type="submit">Search</button>
    </p>
</form>
