{#
    Liste d'offres. Le titre de section est de niveau paramétrable : un widget
    posé dans une page ne connaît pas le niveau de titre qui le précède, et
    imposer un h2 casserait la hiérarchie attendue par le RGAA.
#}
<section class="etk-list" aria-labelledby="{{ heading_id }}">
    <{{ heading_level }} class="etk-list__heading" id="{{ heading_id }}">{{ heading }}</{{ heading_level }}>

    {% if demo_mode %}
        <p class="etk-list__notice" role="note">
            Jeu de démonstration : aucune API n'est configurée.
        </p>
    {% endif %}

    {% if offers is empty %}
        <p class="etk-list__empty">Aucune offre ne correspond à cette recherche.</p>
    {% else %}
        <ul class="etk-list__items">
            {% for offer in offers %}
                <li class="etk-list__item">
                    {% include 'job-card.html.twig' with { offer: offer } only %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
