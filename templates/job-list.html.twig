{#
    The list of offers. The section heading level is configurable: a widget
    dropped into a page knows nothing of the heading that precedes it, and
    forcing an h2 would break the hierarchy accessibility expects.
#}
<section class="etk-list" aria-labelledby="{{ heading_id }}">
    <{{ heading_level }} class="etk-list__heading" id="{{ heading_id }}">{{ heading }}</{{ heading_level }}>

    {% if demo_mode %}
        <p class="etk-list__notice" role="note">
            Demo dataset: no API is configured.
        </p>
    {% endif %}

    {% if offers is empty %}
        <p class="etk-list__empty">No offer matches this search.</p>
    {% else %}
        <ul class="etk-list__items">
            {% for offer in offers %}
                <li class="etk-list__item">
                    {% include 'job-card.html.twig' with { offer: offer } only %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
