{# Fragment shared by the list and the highlight. #}
<article class="etk-card{% if offer.is_recent %} etk-card--recent{% endif %}">
    <header class="etk-card__header">
        <h3 class="etk-card__title">
            <a href="{{ offer.url }}">{{ offer.title }}</a>
        </h3>
        <p class="etk-card__company">{{ offer.company }}</p>
    </header>

    <dl class="etk-card__meta">
        <dt class="etk-card__label">Location</dt>
        <dd class="etk-card__value">{{ offer.location }}</dd>
        <dt class="etk-card__label">Contract</dt>
        <dd class="etk-card__value">{{ offer.contract }}</dd>
        <dt class="etk-card__label">Published</dt>
        <dd class="etk-card__value">
            <time datetime="{{ offer.published_at }}">{{ offer.published_at }}</time>
        </dd>
    </dl>

    <p class="etk-card__excerpt">{{ offer.excerpt }}</p>

    <a class="etk-card__link" href="{{ offer.url }}">
        View offer<span class="etk-visually-hidden">: {{ offer.title }}</span>
    </a>
</article>
